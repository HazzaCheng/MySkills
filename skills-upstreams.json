{
  "version": 1,
  "notes": [
    "This file tracks upstream repositories for skills mirrored in this repo.",
    "Entries here are intentionally conservative: only add paths that can be compared mechanically.",
    "If a skill has no explicit entry, check-upstream-skills.py may fall back to originDefaults or frontmatter repo fields."
  ],
  "originDefaults": {
    "ECC": {
      "repo": "https://github.com/affaan-m/everything-claude-code.git",
      "ref": "main",
      "pathCandidates": [
        "skills/{skill}",
        ".agents/skills/{skill}",
        "{skill}"
      ]
    },
    "ECC direct-port adaptation": {
      "repo": "https://github.com/affaan-m/everything-claude-code.git",
      "ref": "main",
      "pathCandidates": [
        "skills/{skill}",
        ".agents/skills/{skill}",
        "{skill}"
      ]
    },
    "ECC-community": {
      "repo": "https://github.com/affaan-m/everything-claude-code.git",
      "ref": "main",
      "pathCandidates": [
        "skills/{skill}",
        ".agents/skills/{skill}",
        "{skill}"
      ]
    }
  },
  "skills": {
    "ck": {
